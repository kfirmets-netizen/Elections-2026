{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elections-2026",
  "main": "worker.js",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "elections-2026",
      "database_id": "f0108e14-462a-40b3-8d00-0135224dc867"
    }
  ]
}
